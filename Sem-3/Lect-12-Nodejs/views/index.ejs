<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MIRAI - Home</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7ff, #e8edff);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            background: white;
            width: 90%;
            max-width: 700px;
            padding: 50px;
            text-align: center;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
        }

        .logo {
            font-size: 42px;
            font-weight: bold;
            color: #4f46e5;
            margin-bottom: 10px;
        }

        h1 {
            color: #222;
            margin-bottom: 15px;
        }

        p {
            color: #666;
            margin-bottom: 30px;
            font-size: 17px;
        }

        .rating-link {
            display: inline-block;
            padding: 14px 28px;
            background: #4f46e5;
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            transition: 0.3s;
        }

        .rating-link:hover {
            background: #3730a3;
            transform: translateY(-2px);
        }

        .stars {
            font-size: 30px;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="logo">MIRAI</div>

        <h1>Welcome to MIRAI</h1>

        <p>
            Your feedback helps us improve the learning experience.
        </p>

        <div class="stars">
            ⭐ ⭐ ⭐ ⭐ ⭐
        </div>

        <a href="/register" class="rating-link">
            ⭐ Give Your Rating
        </a>

    </div>

</body>
</html>