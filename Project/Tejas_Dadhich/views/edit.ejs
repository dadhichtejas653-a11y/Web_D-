<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Edit Employee</h1>
    <form action="/employee/<%= employee._id %>/update" method="POST">
        <input type="text" name="Employee_name" value="<%= employee.Employee_name %>" require /><br><br>
        <input type="text" name="Email" value="<%= employee.Email %>" require /><br><br>
        <input type="text" name="Department" value="<%= employee.Department %>" require /><br><br>
        <input type="text" name="Salary" value="<%= employee.Salary %>" require /><br><br>
        <input type="text" name="Experience" value="<%= employee.Experience %>" require /><br><br>
        <input type="text" name="Designation" value="<%= employee.Designation %>" require /><br><br>
        <input type="text" name="Joining_Date" value="<%= employee.Joining_Date %>" require /><br><br>
        <button type="submit">Update Employee</button>
    </form>
    <br>
    <a href="/employee">Back to list</a>
</body>
</html>