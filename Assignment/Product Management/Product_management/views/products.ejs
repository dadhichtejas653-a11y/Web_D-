<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stockroom — Inventory Ledger</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #f5f4f0;
    --surface: #ffffff;
    --border: #e0ddd6;
    --border-focus: #1d9e75;
    --text: #1a1a18;
    --muted: #6b6a66;
    --accent: #1d9e75;
    --accent-light: #e1f5ee;
    --accent-border: #9fe1cb;
    --accent-fg: #ffffff;
    --red: #c0392b;
    --red-light: #fdf0ef;
    --red-border: #f5c0bb;
    --amber: #b45309;
    --amber-light: #fef3c7;
    --amber-border: #fcd34d;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
  }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
  }

  a { color: inherit; }

  /* ── Topbar ── */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 5vw;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--text);
  }

  .brand-icon {
    width: 30px;
    height: 30px;
    background: var(--accent);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-icon svg {
    width: 16px;
    height: 16px;
    stroke: #fff;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  .btn-primary:hover { background: #189067; border-color: #189067; }

  .btn-outline {
    background: var(--surface);
    color: var(--muted);
    border-color: var(--border);
  }

  .btn-outline:hover { color: var(--text); border-color: #b0afa9; }

  /* ── Page wrap ── */
  .wrap { padding: 36px 5vw 64px; }

  /* ── Page head ── */
  .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 24px;
  }

  .page-head-left { display: flex; align-items: baseline; gap: 10px; }

  .page-head h1 {
    font-size: clamp(20px, 2.8vw, 26px);
    font-weight: 600;
    color: var(--text);
  }

  .count-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-light);
    border: 1px solid var(--accent-border);
    border-radius: 100px;
    padding: 3px 10px;
  }

  /* ── Toolbar ── */
  .toolbar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 14px 16px;
    margin-bottom: 20px;
  }

  .toolbar form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .field {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 9px 12px;
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .field:focus {
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px rgba(29, 158, 117, 0.12);
    background: #fff;
  }

  .field::placeholder { color: #b0afa9; }

  input.field { flex: 1; min-width: 200px; }
  select.field { min-width: 160px; }

  /* ── Ledger table ── */
  .ledger-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
  }

  thead th {
    text-align: left;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.12s;
  }

  tbody tr:hover { background: #faf9f7; }
  tbody tr:last-child { border-bottom: none; }

  td {
    padding: 14px 18px;
    font-size: 14px;
    vertical-align: middle;
  }

  /* ── SKU cell ── */
  .sku {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-dot.good { background: var(--accent); }
  .status-dot.low  { background: var(--amber); }
  .status-dot.out  { background: var(--red); }

  /* ── Other cells ── */
  .pname { font-weight: 500; color: var(--text); }

  .ptag { font-size: 13px; color: var(--muted); }

  .price {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }

  .stock-cell {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }

  .stock-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid;
  }

  .stock-pill.good {
    color: var(--accent);
    background: var(--accent-light);
    border-color: var(--accent-border);
  }

  .stock-pill.low {
    color: var(--amber);
    background: var(--amber-light);
    border-color: var(--amber-border);
  }

  .stock-pill.out {
    color: var(--red);
    background: var(--red-light);
    border-color: var(--red-border);
  }

  /* ── Action buttons ── */
  .actions { display: flex; gap: 6px; }

  .icon-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg);
    text-decoration: none;
    cursor: pointer;
    color: var(--muted);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .icon-btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-btn.edit:hover {
    color: var(--accent);
    border-color: var(--accent-border);
    background: var(--accent-light);
  }

  .icon-btn.del:hover {
    color: var(--red);
    border-color: var(--red-border);
    background: var(--red-light);
  }

  /* ── Empty state ── */
  .empty {
    text-align: center;
    padding: 64px 20px;
  }

  .empty-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--accent-light);
    border: 1px solid var(--accent-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
  }

  .empty-icon svg {
    width: 22px;
    height: 22px;
    stroke: var(--accent);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .empty h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .empty p {
    font-size: 13.5px;
    color: var(--muted);
    margin-bottom: 22px;
  }

  /* ── Responsive ── */
  @media (max-width: 680px) {
    .toolbar form { flex-direction: column; align-items: stretch; }
    input.field, select.field { min-width: unset; width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; }
  }
</style>
</head>
<body>

<header class="topbar">
  <a href="/" class="brand">
    <span class="brand-icon">
      <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
    </span>
    <span class="brand-name">Stockroom</span>
  </a>
  <a href="/insertdata" class="btn btn-primary">
    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Log new stock
  </a>
</header>

<div class="wrap">

  <div class="page-head">
    <div class="page-head-left">
      <h1>Inventory ledger</h1>
      <span class="count-badge"><%= allproduct.length %> item<%= allproduct.length === 1 ? '' : 's' %></span>
    </div>
  </div>

  <div class="toolbar">
    <form action="/getdata" method="GET">
      <input class="field" type="text" name="search"
             placeholder="Search by name, category or company"
             value="<%= typeof search !== 'undefined' ? search : '' %>">
      <select class="field" name="sort">
        <option value=""    <%= (typeof sort === 'undefined' || sort === '') ? 'selected' : '' %>>Sort: default</option>
        <option value="low" <%= sort === 'low'  ? 'selected' : '' %>>Price: low → high</option>
        <option value="high"<%= sort === 'high' ? 'selected' : '' %>>Price: high → low</option>
      </select>
      <button type="submit" class="btn btn-primary">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Search
      </button>
      <a href="/getdata" class="btn btn-outline">Reset</a>
    </form>
  </div>

  <% if (allproduct.length === 0) { %>
    <div class="ledger-wrap">
      <div class="empty">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
        </div>
        <h3>No stock logged yet</h3>
        <p>Once you add a product it will appear here in the ledger.</p>
        <a href="/insertdata" class="btn btn-primary">
          <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Log new stock
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="ledger-wrap">
      <table>
        <thead>
          <tr>
            <th>SKU</th>
            <th>Product</th>
            <th>Category</th>
            <th>Company</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% allproduct.forEach(function(p){
               var sku = p._id.toString().slice(-6).toUpperCase();
               var statusClass = p.stock === 0 ? 'out' : (p.stock <= 10 ? 'low' : 'good');
               var stockLabel  = p.stock === 0 ? 'Out of stock' : (p.stock <= 10 ? 'Low' : 'In stock');
          %>
          <tr>
            <td>
              <span class="sku">
                <span class="status-dot <%= statusClass %>"></span>
                #<%= sku %>
              </span>
            </td>
            <td class="pname"><%= p.name %></td>
            <td class="ptag"><%= p.category %></td>
            <td class="ptag"><%= p.company %></td>
            <td class="price">₹<%= p.price %></td>
            <td class="stock-cell">
              <span class="stock-pill <%= statusClass %>">
                <%= p.stock %> — <%= stockLabel %>
              </span>
            </td>
            <td>
              <div class="actions">
                <a class="icon-btn edit" href="/edit/<%= p._id %>" title="Edit entry">
                  <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </a>
                <a class="icon-btn del" href="/delete/<%= p._id %>" title="Delete entry"
                   onclick="return confirm('Remove &quot;<%= p.name %>&quot; from the ledger?');">
                  <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                </a>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>

</body>
</html>