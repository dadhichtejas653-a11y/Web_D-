<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hello.....</h1>
    <h1>My name is <%= Parth.name %></h1>
    <h1>My age is <%= Parth.age %></h1>
    <h1>I am from <%= Parth.city %></h1>
    <h1>My favourite color is <%= color %></h1>
    <p>Your email address is:.....</p>
