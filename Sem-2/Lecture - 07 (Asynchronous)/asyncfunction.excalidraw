      "updated": 1771995135175,
      "link": null,
      "locked": false,
      "text": "const p1 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"hello\");\n    }, 2000);\n})\nconsole.log(\"start\");\n\nasync function fun() {\n    console.log(\"async start\");\n    const response = await p1;\n    console.log(p1);\n    \n    console.log(\"async end\");\n}\n\n\nfun()\n\nconsole.log(\"end\");\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const p1 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"hello\");\n    }, 2000);\n})\nconsole.log(\"start\");\n\nasync function fun() {\n    console.log(\"async start\");\n    const response = await p1;\n    console.log(p1);\n    \n    console.log(\"async end\");\n}\n\n\nfun()\n\nconsole.log(\"end\");\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
