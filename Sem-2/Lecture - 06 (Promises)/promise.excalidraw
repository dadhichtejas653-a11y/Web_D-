    {
      "id": "UnKONTmeR1CY2ivadcNxY",
      "type": "text",
      "x": 290.81829021530154,
      "y": 2306.0656243390176,
      "width": 1056.5232160393014,
      "height": 110.5527311891775,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1413815147,
      "version": 327,
      "versionNonce": 349219947,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "25oX1uJqj7kqRznKWuONt",
          "type": "arrow"
        }
      ],
      "updated": 1771994224318,
      "link": null,
      "locked": false,
      "text": "Promise.race() settles with the first promise to either resolve or reject,\nwhile Promise.any() resolves with the first success and rejects only if all \npromises reject (via AggregateError).",
      "fontSize": 29.480728317114,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Promise.race() settles with the first promise to either resolve or reject,\nwhile Promise.any() resolves with the first success and rejects only if all \npromises reject (via AggregateError).",
      "autoResize": true,
      "lineHeight": 1.25
    },
