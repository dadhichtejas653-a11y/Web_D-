    {
      "id": "lBsQyQSOdIDyFhRWMc1yV",
      "type": "text",
      "x": 346.7977756459418,
      "y": 234.34652882278095,
      "width": 576.6596069335938,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1435381963,
      "version": 6,
      "versionNonce": 1624622795,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771993270224,
      "link": null,
      "locked": false,
      "text": "const p2 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"p2\");\n    }, 100);\n    \n});\n\nconst p3 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"p3\");\n    }, 150);\n    \n});\n\nconst p4 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"p4\");\n    }, 130);\n    \n});\n\nconst result = Promise.all([p1,p2,p3,p4]);\nconsole.log(result.then((response)=>console.log(response)));",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const p2 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"p2\");\n    }, 100);\n    \n});\n\nconst p3 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"p3\");\n    }, 150);\n    \n});\n\nconst p4 = new Promise((resolve,reject)=>{\n    setTimeout(() => {\n        resolve(\"p4\");\n    }, 130);\n    \n});\n\nconst result = Promise.all([p1,p2,p3,p4]);\nconsole.log(result.then((response)=>console.log(response)));",
      "autoResize": true,
      "lineHeight": 1.25
    },
